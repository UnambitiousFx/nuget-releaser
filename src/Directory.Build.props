<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove(&#39;build.props&#39;))" />
    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageOutputPath>$(SolutionDir)local_packages</PackageOutputPath>

        <!-- Package metadata -->
        <Authors>UnambitiousFx</Authors>
        <Company>UnambitiousFx</Company>
        <Description>Goreleaser-style release tool for .NET repositories: versions, packs and publishes each NuGet package independently, from conventional commits and per-package git tags.</Description>
        <PackageTags>nuget;release;semantic-release;versioning;semver;monorepo;conventional-commits;dotnet-tool</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) UnambitiousFx $([System.DateTime]::Now.Year)</Copyright>

        <!-- Repository metadata -->
        <RepositoryUrl>https://github.com/UnambitiousFx/nuget-releaser.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageProjectUrl>https://github.com/UnambitiousFx/nuget-releaser</PackageProjectUrl>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Source link and symbols -->
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- Build configuration -->
        <GeneratePackageOnBuild Condition="'$(CI)' == 'true'">true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <Deterministic>true</Deterministic>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup Condition="$(CI) == 'true'">
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$([MSBuild]::GetPathOfFileAbove('README.md'))" Pack="true" PackagePath="\" />
        <None Include="$([MSBuild]::GetPathOfFileAbove('icon.png'))" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    </ItemGroup>
</Project>

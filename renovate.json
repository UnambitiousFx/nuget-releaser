{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "schedule": [
    "before 4am on monday"
  ],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "reviewers": [
        "Oleexo"
      ]
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "Microsoft.**"
      ],
      "groupName": "microsoft"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "BenchmarkDotNet**"
      ],
      "groupName": "benchmarkdotnet"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "xunit**",
        "NSubstitute**",
        "coverlet**"
      ],
      "groupName": "testing"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "docs/**"
      ],
      "groupName": "docs"
    }
  ]
}
